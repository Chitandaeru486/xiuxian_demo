 600,\n      \"new_standard_days\": 3750.0,\n      \"old_ideal_years\": 1.6666666666666667,\n      \"new_ideal_years\": 10.416666666666666\n    },\n    {\n      \"gain\": 40,\n      \"target_root\": 90,\n      \"old_standard_days\": 1200,\n      \"new_standard_days\": 13500.0,\n      \"old_ideal_years\": 3.3333333333333335,\n      \"new_ideal_years\": 37.5\n    }\n  ],\n  \"analytic_checks\": {\n    \"map\": 36864,\n    \"normal_pill_foundation_before\": 0.7,\n    \"normal_pill_foundation_root62\": 0.95,\n    \"scar5_root50_to45_gold_before\": 0.3,\n    \"scar5_root50_to45_gold_after\": 0.2799098974610422,\n    \"scar5_ceiling\": 95,\n    \"drop_finish_healing_age_bound\": 100.5,\n    \"compensated_low_root90_foundation\": 0.6616502524782922,\n    \"high_normal_foundation\": 0.5120000000000001,\n    \"compensated_low_root90_gold\": 0.0654789556732492,\n    \"high_normal_gold\": 0.40960000000000013,\n    \"ideal_low_reach_root90_age\": 108.03055555555555,\n    \"low_root90_qi_natural_lifespan\": 117.5\n  },\n  \"limitations\": [\n    \"Infinite supplies and instant procurement\",\n    \"Fixed starting age, not talent-specific lifecycle\",\n    \"No added polishing in the 6 stress cohorts; compare cost curves separately\",\n    \"Restore temporary roots after healing; permanent scars reduce current roots and cap\",\n    \"Drop terminates cohort at healing-feasibility test, re-foundation not simulated\",\n    \"No population/market simulation\",\n    \"Candidate constants not frozen by user\"\n  ]\n}\n"}
