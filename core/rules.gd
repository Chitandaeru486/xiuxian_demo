extends RefCounted

const VERSION = "s1-rules.1"
const YEAR = 518400
const DAY = 1440
const REALMS = ["凡人", "炼气", "筑基", "金丹"]
const MULTIPLIERS = [1, 2, 4, 24, 360]
const PHASES = {"breakthrough_complete":1,"death_check":2,"production":3,"move_complete":4,"action_complete":5,"random_complete":5,"command":5,"survival":6,"reminder":7,"plan":8}
const ACTION_STATES = ["planned","reserved","travelling","executing","completed","cancelled","failed"]

static func config() -> Dictionary:
	return {"version":VERSION,"calendar":{"days_per_month":30,"months_per_year":12,"minutes_per_day":DAY},"lifespan_years":{"凡人":[60,80],"炼气":[100,135],"筑基":[170,230],"金丹":[290,400]},"root_cap":100,"candidate":{"status":"candidate","version":"breakthrough-candidate.2","enabled":false,"formula_used":false,"scope":"verbatim reference snapshots; formulas inactive","reference_documents":CANDIDATE_REFERENCES.duplicate(true)}}

static func natural_days(person: Dictionary, rules: Dictionary) -> int:
	var span: Array = rules.lifespan_years[person.realm]
	return int(span[0]) * 360 + int((int(span[1]) - int(span[0])) * 360 * int(person.lifespan_quantile) / 10000)

static func derived(person: Dictionary, minute: int, rules: Dictionary) -> Dictionary:
	var natural = natural_days(person,rules)
	var age_minutes: int = minute - int(person.birth_minute)
	var effective: int = natural - int(person.burn_days)
	return {"age_minutes":age_minutes,"age_years":int(age_minutes / YEAR),"natural_lifespan_days":natural,"effective_lifespan_days":effective,"remaining_lifespan_minutes":effective * DAY - age_minutes,"root_effective":clampi(int(person.g_trained)-int(person.root_scar)-int(person.root_wound),1,maxi(1,int(rules.root_cap)-int(person.root_scar))),"root_cap":maxi(1,int(rules.root_cap)-int(person.root_scar))}

const CANDIDATE_REFERENCES = {"18-突破机制候选与纸面验证.md": "# 18 突破机制候选与纸面验证\n\n版本：breakthrough-candidate.1；日期：2026-10-28。**本文件为候选1历史快照，当前候选为[22候选2](22-突破候选2与评审结论.md)**；旧固定打磨成本/只损根基上限解释不再作为当前候选。压力评审见21，保留本文件用于对照，均未自动冻结数值。\n\n依据：D-V1-18/19/20三轮访谈及T4A覆盖确认。用户已同意进入候选公式、失败数表和人物推演阶段；**没有将本文新增的指数、概率上限、配方或损失数值逐项批准**。本文是可评审候选，尚未接入游戏，没有做完整人口/资源模拟。\n\n## 1. 已确认的完整方向\n\n| 内容 | 当前确认 |\n| --- | --- |\n| 基准 | 资质50、悟性50、正常根基倍率1；筑基无丹20%/标准丹70%，金丹无丹10%/标准丹30% |\n| 天赋与后天 | 资质差异显著，高阶更大；悟性缩短领悟准备并提高概率；根基来自真实修炼。筑基可通过悟性/根基逆转资质差，金丹很难 |\n| 保证成功 | 合格且正常完成的凡人入炼气可100%；筑基/金丹不能保证，无额外最高名额 |\n| 丹药辅物 | 主丹最多一枚、可有品质；丹药按倍率，辅物有专长且主要稳根基/减伤。灵果可直接辅助或炼丹，同源不重复 |\n| 阶段 | 准备期退出只损已用时间；关键期耗药，退出/中断损寿元和修为；主动退出较轻，外界打断较重 |\n| 寿元 | 燃寿独立永久累计，当前及未来境界上限均扣，出生年龄不改，晋阶不清除 |\n| 风险 | 筑基主要损失/可恢复伤，金丹可死或从筑基退炼气；各次真实成本下可独立重试 |\n| 重试 | 修为、伤势及其他必要条件恢复即可再试，不加固定倒计时冷却；不能把未恢复视作准备完成 |\n| 信息 | 玩家/NPC只看到区间和评价，精度依知识/师承/经历；临寿可更愿冒险，不是人人必搏命 |\n\n**T2 A+B组合解释，待候选评审核对：** 常规及大部分重伤有手段最终修复，时间/资源是限制；冲击金丹的“极重伤”分支可能留下永久根基/潜力损失。不是把所有伤都写成永久，也不是许诺一切损伤必定修复。此解释用于本次推演，并非用户已单独确认了例外分界和永久数值。\n\n## 2. 候选变量与根基\n\n- `a`：资质1～100；`w`：悟性1～100。\n- `g_base`：当前阶段真实培养得到的根基评分；正常圆满者50。\n- `root_wound`：可恢复根基损伤；`root_scar`：永久根基上限损失。\n- `g = clamp(g_base-root_wound, 1, 100-root_scar)`：本次有效根基；禁止把纯随机生成的“根基好坏”当作成长结果。\n- `burn_days`：累计永久燃寿，整数世界日；与实际出生年龄、可恢复根基伤分别记录。\n\n根基生成实施提案：修炼进度同时登记合规且状态稳定的积累比例，正常完成者圆满根基50；带饥饿/疲劳/伤势强行积累的部分降低合规比例。圆满后可用真实时间打磨，每30标准打磨日提高1根基，至当前根基上限；打磨占主要行动/日预算，不同时再增加修为。根基账目必须能回指积累/打磨/损伤事件。\n\n该生成办法和打磨速度为候选，不是新硬性终身境界上限；永久根基疤痕也不直接变成“最高只能炼气”等锁死规则。正常晋阶后新的阶段保留旧根基历史，重新培养本阶根基；跨境界继承系数属于后续调参，不在纸面算例中默默添加优势。\n\n## 3. 候选成功率\n\n全部概率以0～1表示，最终判断前检查资格、功法、积累、环境、伤势和剩余寿元；不合格是拒绝，不是给0.1%强行抽奖。\n\n```text\n筑基原始概率 = 0.20 × (a/50)^2 × 2^((w-50)/25) × 2^((g-50)/25)\n金丹原始概率 = 0.10 × (a/50)^3 × 2^((w-50)/50) × 2^((g-50)/50)\n\n最终概率 = clamp(原始概率 × 同源助力最大倍率, 0.001, 境界上限)\n候选上限：筑基0.95，金丹0.90；下限0.001仅适用于合格尝试。\n```\n\n为何提供两个不同形状：筑基允许悟性/根基显著补偿资质；金丹对资质使用更强指数、悟性/根基补偿相对更弱。**平方/立方、分母25/50、95%/90%和0.1%下限都是候选数值**，可以调参，但不能破坏确认锚点、方向和高阶不保证成功。\n\n“同源助力最大倍率”仅处理主丹/直接灵果等属于同一助力槽的替代来源；减伤/恢复等不同效果另算，不把全部辅助物压成一项。\n\n## 4. 丹药品质、直接灵果与配方候选\n\n| 概率助力 | 劣品 | 标准 | 优品 | 约束 |\n| --- | ---: | ---: | ---: | --- |\n| 筑基丹 | ×2.8 | ×3.5 | ×4.2 | 主丹最多1枚 |\n| 金丹突破丹，工作名“凝金丹” | ×2.4 | ×3.0 | ×3.6 | 同上，不新增境界 |\n| 直接使用凝丹灵果 | — | ×1.5 | — | 仅金丹，关键期消耗 |\n\n金丹同时带丹和灵果时采用同源助力的最大值，不乘成3×1.5；开始前提示哪些物品属于替代项，默认只消耗选定项，不把无效叠加物白白扣掉。“同源”按内容效果标签识别，不能只比较是否同一颗果的物品ID。\n\n标准筑基丹沿用5聚灵草+10普通药材+1下品石/24工作小时→1枚。标准凝金丹候选：1凝丹灵果+20聚灵草+40普通药材+1中品石/72工作小时→1枚，至少筑基且掌握相应炼丹知识。基准配方产标准品；劣/优品的生成条件须以实际技艺/配方记录，不能无材料免费点选优品。后续品质内容未完成不宣称已有完整炼丹体系。\n\n辅助物候选“护脉散”：10普通药材+2聚灵草+2下品石/12工作小时→1份，关键期使用，使非死亡结果的燃寿、可恢复伤势和可恢复根基损失×0.8；不改成功率、不消除死亡/掉境分支，也不抹去候选永久疤痕。标准情形下概率到上限后，它仍有减损价值。精确配方/效果属于候选，不覆盖玩家已确认范围之外的完整装备系统。\n\n加工继续按既有托管策略：完成才耗加工材料并产物，取消退未耗材料；突破则关键期才消耗所选主丹/灵果/辅物，二者不是同一退款时点。\n\n## 5. 数值对照（基础公式，无减伤辅物）\n\n| 人物 | 资质/悟性/根基 | 筑基无丹 | 筑基标准丹 | 金丹无丹 | 金丹标准丹 |\n| --- | --- | ---: | ---: | ---: | ---: |\n| 标准修士 | 50/50/50 | 20.00% | 70.00% | 10.00% | 30.00% |\n| 低资质、普通准备 | 30/50/50 | 7.20% | 25.20% | 2.16% | 6.48% |\n| 高资质、普通准备 | 80/50/50 | 51.20% | 95.00% | 40.96% | 90.00% |\n| 低资质、高悟性、扎实根基 | 30/90/90 | 66.16% | 95.00% | 6.55% | 19.64% |\n| 标准资质、准备较差 | 50/30/30 | 6.60% | 23.09% | 5.74% | 17.23% |\n| 多项优秀 | 80/80/80 | 95.00% | 95.00% | 90.00% | 90.00% |\n\n第四行筑基超过第三行，金丹明显落后，吻合S3方向。上限使天才仍可能失败，但也暴露“富裕且高天赋者非常稳”的世界结果，需用户评审这种体感；不能靠隐藏降低抽样概率修正。\n\n## 6. 准备与关键期候选\n\n| 转换 | 悟性50准备期 | 关键期 | 正常合计 |\n| --- | ---: | ---: | ---: |\n| 凡人入炼气 | 0.75日 | 0.25日 | 1日 |\n| 筑基 | 7日 | 3日 | 10日 |\n| 金丹 | 24日 | 6日 | 30日 |\n\n准备耗时提案：`基础准备日 × clamp(50/w, 0.5, 2)`；关键期不因悟性被压至0。准备期退出释放预留，只损已过时间，生活消耗照常；关键期开始将所选药物/辅物标记已耗，离线/暂停不额外推进。\n\n进入前必须满足所有已知前置。关键期中的环境失效、生存条件不足等走中断，不能等价成“无风险取消”。恢复后可重新准备，不复用上次已消耗药物。成功与失败的正式结算只能提交一次。\n\n## 7. 失败数表候选\n\n下表百分比均为**已经失败之后的条件分支权重**，不是所有尝试的绝对死亡/伤害率。燃寿单位为360日世界年；修为保留比例相对该阶段满值，重修以缺口计算，不从出生起重修。\n\n### 7.1 冲击筑基失败\n\n| 分支 | 失败中权重 | 保留积累 | 额外燃寿 | 伤势/根基 | 恢复基线 |\n| --- | ---: | ---: | ---: | --- | --- |\n| 经脉震荡 | 60% | 80% | 1年 | 无需专门疗伤 | 重修至满 |\n| 轻伤 | 30% | 65% | 3年 | 可恢复伤势30、根基−10 | 180恢复日，根基修复后再按缺口重修 |\n| 重伤 | 10% | 50% | 5年 | 可恢复伤势60、根基−20 | 360恢复日，之后重修 |\n\n不另设直接死亡/掉境分支；但燃寿使上限低于实际年龄，仍可能自然寿终。这样不会借“筑基失败不直接致死”绕过已确认的永久燃寿。\n\n### 7.2 冲击金丹失败\n\n| 分支 | 失败中权重 | 保留积累/境界 | 燃寿 | 损伤 | 恢复基线 |\n| --- | ---: | --- | ---: | --- | --- |\n| 凝丹失败 | 45% | 筑基、85%积累 | 3年 | 可恢复伤20 | 180恢复日后重修 |\n| 经脉重创 | 30% | 筑基、70%积累 | 8年 | 伤50、可恢复根基−15 | 360恢复日后重修 |\n| 道基崩散 | 15% | **退回炼气**，本次金丹积累清零，筑基段恢复到50%积累 | 15年 | 伤60、可恢复根基−25 | 720恢复日；先重新筑基，再培养金丹积累 |\n| 极重根基伤 | 5% | 筑基、50%积累 | 20年 | 伤80、可恢复根基−20，另留永久根基上限−5 | 1080恢复日；永久部分按T2组合解释，不可用普通疗伤抹掉 |\n| 神魂崩解 | 5% | 死亡 | — | 不进入恢复流程 | 处理遗产与行动取消 |\n\n例如标准修士有丹金丹成功率30%，单次尝试的直接死亡率为70%×5%=3.5%，**不是5%更不是70%**；余寿耗尽带来的寿终另计。护脉散不改变上述分支权重，只按效果减可减损失。\n\n所有恢复日表示有效恢复日：按角色实际可执行的调息累计，候选基线每日6小时有效调息。受伤筑基/金丹才产生此需求；健康时无例行恢复。恢复期候选禁止冲关，工作效率0.5、可求助/交易；结束只解除可恢复部分，未满积累还要重修。标准算例先恢复再重修，不暗中把同一小时两次记进度。实际调息的少量修为按既有10%规则结算，纸面例为隔离成本先忽略这点小幅抵扣。\n\n## 8. 退出、中断与燃寿提交\n\n| 情形 | 候选处理 |\n| --- | --- |\n| 前置拒绝 | 不开始、不耗药、不抽样 |\n| 准备期主动退出 | 只损经过时间，释放未耗药/预算；生活消耗不返还 |\n| 关键期主动退出筑基/金丹 | 保留90%/90%积累，燃寿0.5/2年，已用药不退；没有额外伤害抽样 |\n| 关键期外界中断筑基/金丹 | 保留75%/65%，燃寿2/8年，伤30/50，按180/360恢复日基线；不再叠抽一次正常失败 |\n| 同刻失败、燃寿使余寿归零 | 同一事务先提交结果/燃寿，再判断死亡，不多推进一天 |\n| 同刻成功与原寿终 | 先成功，再按新境界总寿元减累计燃寿判断存活；新上限仍不足则寿终 |\n\n“外界中断”只指已实现且真实发生的环境/生存/事件失效，不为了触发惩罚额外生成未实现战斗。保护效果只减标记可减的损失；永久燃寿一旦提交，普通休息、疗伤、服恢复药、晋阶、换角色、读当前档都不删除。\n\n## 9. 永久燃寿与候选根基伤解释\n\n```text\n境界自然寿元 = 按固定分位q在已确认区间内插值\n有效寿元上限 = 境界自然寿元 - burn_days/360\n余寿 = 有效寿元上限 - 实际出生年龄\n```\n\n例如q=5000筑基自然寿元200年，累计燃寿10年，有效190年；之后金丹自然345年，有效335年。年龄字段始终是实际经历，不能把燃寿直接伪装成世界过去10年。\n\n掉回炼气时也用炼气自然上限117.5年扣累计燃寿，可能当场寿终。候选例：130岁筑基冲金丹掉回炼气，本次燃寿15年，则上限102.5年，实际130岁，死亡；不能把“掉境”误当成必定可继续恢复。\n\n根基伤和寿元损失不同：伤势/临时根基可恢复；候选永久根基疤痕降低根基培养上限；燃寿永久扣所有未来寿元。三类分账并显示原因，避免一瓶疗伤药顺便清掉所有代价。\n\n## 10. 知识、概率区间与NPC\n\n机制层保留真概率，但玩家/NPC查询不直接得到它。候选判断流程先根据可获得的检测、功法、师承、尝试记录估计资质/根基/环境/丹品区间，再把这些输入区间带入同一公式求概率范围；缺失输入就扩大区间，不能用真概率中心加随机误差假装人物不知道。\n\n展示“凶险/勉强/可试/较稳妥”等评价加区间，注明来源不足或可能误判；内部调试/验收可读取真值，不属于玩家天道面板默认权限。天道可以看真实属性的已确认方向不等于自动拿到所有隐藏函数和精确结果。\n\nNPC以自身估计区间、性格、余寿、资源和责任选择尝试或继续打磨；临寿降低可接受风险门槛，仍可因家人/传承选择不搏命。门槛系数是调参候选，不加入“每个人最终必须尝试”脚本。\n\n## 11. 人物时间线与成本对照\n\n均为固定分支的纸面推演，**不是实际游戏模拟或每个人必然的命运**。为隔离突破成本，采用每天8小时、基础积累效率1、环境1、无额外灵石增益、忽略少量调息修为；18岁起修，学习/谋生额外时间先略。q=5000。\n\n| 情景 | 推演 | 结论 |\n| --- | --- | --- |\n| 标准者首次筑基成功 | 18+16+1/360+26+10/360≈60.031岁；无燃寿 | 新自然寿元200，年龄不重置 |\n| 首次筑基普通失败，再成功 | 第一次在60.031岁失败，燃寿1年；缺20%炼气段，重修26×20%=5.2年；再尝试10日，约65.258岁成功 | 有效筑基寿元199，剩约133.742年；无额外30日冷却 |\n| 首次金丹普通失败，再成功 | 全顺利路径约102.114岁首次冲金丹结束；失败燃寿3年，恢复180日=0.5年，补42×15%=6.3年，再尝试30日；约108.997岁成功 | 有效金丹寿元342，余约233.003年；恢复不抹燃寿 |\n| 根基补偿对照 | 30/90/90对80/50/50：筑基66.16%对51.20%，金丹6.55%对40.96% | 低资质可以后天逆转筑基差距，金丹仍很难 |\n| 寿终同刻成功 | 70岁凡人、累计燃寿0，入炼气已合法到期 | 先成功，新上限117.5，可生存；若同刻已燃寿足使新上限≤70仍死亡 |\n| 高龄掉境 | 130岁筑基退炼气且新增燃寿15 | 上限102.5＜年龄，立即寿终，不继续执行恢复队列 |\n\n时间表纳入凡人入炼气的1日及每次突破的10/30日；同一人多次失败须累加所有燃寿。不能把把关时间一会儿算净修炼、一会儿漏算。\n\n## 12. 已做的纸面检查与实际限制\n\n已用本地计算核对：四个概率锚点；丹药倍率；六组人物的补偿/资质差异；概率上限；失败条件权重分别合计100%；燃寿跨阶保留；两次突破时间线；掉境后余寿即时判断。不是代码功能测试。\n\n候选筑基失败的平均积累缺口27.5%，对应标准26年段平均重修7.15年；不含恢复/尝试时间。标准有丹者若条件不变且能完成三次，至少一次成功仍97.3%。**本版候选不能仅凭失败表证明筑基少见、金丹极罕见**；富裕者可能仍有足够余寿重试，需连同材料流通、资质分布、准备/根基恢复和NPC意愿做世界模拟。\n\n候选上限会让多项优秀者接近95%/90%，这是需要评审的体感，不通过暗改骰子隐藏。T2组合解释、维生/调息被动收益、新丹药品质产出及世界补充预算同样不得冒充已经验证。\n\n## 13. 下一步\n\n本专题覆盖检查已由T4A通过，可以结束访谈阶段。下一步评审本文候选中的概率曲线/上限、两阶失败严重度、T2组合解释和配方；确认或调整后冻结 `breakthrough-v1`，再进入S1骨架实现。若先做独立骨架，不得把候选数值偷偷写成正式规则。\n", "22-突破候选2与评审结论.md": "# 22 突破候选2与评审结论\n\n日期：2026-10-29；版本：breakthrough-candidate.2；裁决D-V1-21。\n\n用户选择V1A/V2B/V3A/V4AB：充分准备的富裕者高成功率可以接受；根基打磨边际成本递增；掉境立即按较低境界寿元重算并接受多数正常年龄者难生还；极重永久伤同时影响当前根基与未来培养上限。\n\n**状态：** 以上取舍已确认；本文新增打磨函数、具体永久伤点数、18中的概率指数/上限/失败权重/配方仍是候选调参值，不因完成复验自动冻结。本轮未创建Godot工程，未修改Demo。\n\n## 1. 相对候选1的改动\n\n| 项目 | 候选2 |\n| --- | --- |\n| 稀缺口径 | 面向全体/有根人群，由真实师承、资源、积累时间和风险形成；不要求充分准备的富裕标准人物也必须低成才率，不暗改单次20/70/10/30锚点 |\n| 概率形状 | 暂沿用18的筑基平方/金丹立方、悟性/根基补偿、95%/90%候选上限，保留标准锚点 |\n| 打磨成本 | 取消每点固定30标准日，改为额外打磨点数越高，每点成本越高，函数见下 |\n| 永久伤 | 同一永久伤点数同时降低当前有效根基和最高可培养有效根基，**只扣一次**，不先减基数又重复减上限 |\n| 掉境 | 炼气自然寿元表减累计燃寿，按年龄立即判断存活；不保留曾在筑基获得的寿元，不偷偷加宽限期 |\n| 其余规则 | 准备退只损时间，关键期耗药并可损修为/永久燃寿；恢复准备条件即可再试，无额外固定冷却；独立合法抽样，区间认知和同源助力不叠加 |\n\n18仍作为候选1历史快照；有冲突时采用本文件候选2差异，不能同时使用两种打磨成本或永久伤算法。\n\n## 2. 递增打磨成本候选\n\n正常圆满根基50仍由实际合规积累形成，不额外支付打磨费用；这里计算正常培养之上的额外打磨。令 `n` 为当前境界第n个额外打磨点，从1计起：\n\n```text\n第n点成本 = 30 × (1 + n/2) 标准打磨日\n前N点累计成本 = 30 × [N + N(N+1)/4] 标准打磨日\n1标准打磨日 = 8小时有效打磨；与主要修炼共用行动时间预算\n```\n\n| 从正常根基50提高到 | 增加点数 | 候选1成本，理想年 | 候选2成本，理想年 |\n| --- | ---: | ---: | ---: |\n| 51 | 1 | 0.0833 | 0.1250 |\n| 55 | 5 | 0.4167 | 1.0417 |\n| 62 | 12 | 1.0000 | 4.2500 |\n| 70 | 20 | 1.6667 | 10.4167 |\n| 90 | 40 | 3.3333 | 37.5000 |\n\n理想年按每天8小时、360日/年换算；工作、路途、调息、谋生、伤势和中断还会延长，不能直接把标准日当作自然日保证完成。打磨进度/历史点数保存，退行动、受伤、疗伤、读档不重置边际费用。晋阶建立新境界培养记录，旧境界记录保留，掉回原境界不能获得第二次“低价新手打磨”。\n\n这会把标准有丹者触及筑基95%所需的50→62，从约1年提高到4.25理想年；仍是可选策略，但不再是原候选的低成本一年补满。没有声称4.25年已是最优值，后续按NPC选择与余寿模拟调参。下述高悟性人物路径为与旧路径对照，保守沿用1日入道/10日筑基尝试，不叠加悟性缩短准备期，因此不会夸大生存窗口。\n\n**检查后天逆转没有被成本直接删掉：** 资质30/悟性90人物，按基础效率0.8、正常根基50，18岁起修，不计学习/谋生，入炼气约38.003岁、积累到筑基门槛约70.503岁；再花37.5理想年到根基90，约108.003岁开始尝试、108.031岁结束。其炼气自然寿元中位117.5年，仍存在第一次尝试窗口；但已经很难承受多次失败。这只是有利纸面路径，不保证正常世界资源/生活安排能复制。\n\n## 3. 永久伤：当前与上限一体扣除\n\n采用以下候选状态表达：\n\n```text\ng_trained：实际培养/打磨形成的原始根基，范围1～100\nwound：可恢复根基伤\nscar：累计永久根基损失，候选截断至0～99\n\neffective_cap = max(1, 100 - scar)\ng_effective = clamp(g_trained - wound - scar, 1, effective_cap)\n```\n\n永久伤5点时：\n\n- 原始根基50、临时伤0 → 当前有效45、未来有效上限95。\n- 原始根基100 → 当前有效95、未来有效上限95，**不是90**。\n- 后续培养可以补偿当前不足，但不能超过有效上限；不能重置scar或以普通疗伤清除scar。\n- wound可随治疗清除；scar永久，燃寿又是独立字段，三者不混用。\n\n对标准金丹有丹者，临时伤已恢复但永久伤5点后：有效根基50→45，概率从30%降至约27.991%；原来的候选1只压培养上限，对根基50者概率仍30%。这使永久代价在当前也可见，但不直接变成终身境界硬锁。\n\n18的极重伤分支“可恢复根基−20+永久损失5”应写成两个字段：临时恢复前有效25，恢复临时伤后有效45；不得把永久部分一起当成25点普通伤治掉。伤势数值和分支发生率仍待候选冻结，不代表每次失败都会留永久伤。\n\n## 4. 掉境寿元：接受真实残酷结果\n\n正式确认候选1曾作为假设的边界：掉境后不保留高境界自然寿元，用较低境界自然寿元减累计燃寿立即判断。\n\n标准q=5000、冲金丹掉炼气并燃寿15年时，上限117.5−15=102.5年；原失败时年龄超过102.5则当场寿终。若小于此值，可继续但不保证有足够时间疗伤、重修。既有720恢复日基线下，能完成最初疗伤要求失败年龄小于100.5岁；标准首冲金丹约102.114岁，因此掉境后多半无法完成恢复。\n\n**这次已是用户接受的体验取舍，不再标为必须修复的逻辑错误。** 年轻/快速成长者仍可能有窗口；不为所有人自动提供救援、延寿或宽限。UI在开始冲关时应给出基于已知信息的严重风险理由，不能只提示泛化“可能损修为”。NPC可因余寿与责任放弃，也可搏命。\n\n## 5. 同条件复验\n\n数据见[23候选2复验数据](23-突破候选2复验数据.json)。沿用20的6组各30000、相同种子、起始年龄、无限资源、独立抽样和候选1失败权重；本轮仅新增永久伤对当前根基的影响。**六组未主动打磨**，因此打磨变化另用解析成本与人物路径检查；不能将六组结果冒称新打磨策略已完整模拟。\n\n| 压力组 | 初始单次概率 | 候选1最终晋阶 | 候选2最终晋阶 |\n| --- | ---: | ---: | ---: |\n| 筑基标准无丹 | 20% | 77.9633% | 77.9633% |\n| 筑基标准有丹 | 70% | 99.9433% | 99.9433% |\n| 筑基固定上限 | 95% | 100.0000% | 100.0000% |\n| 金丹标准无丹 | 10% | 31.1700% | 31.0200% |\n| 金丹标准有丹 | 30% | 66.5567% | 66.3500% |\n| 金丹固定上限 | 90% | 97.7833% | 97.7800% |\n\n表中筑基100%是30000有限样本恰好全部成功，不等于机制保证成功。金丹固定上限组起始概率按上限给定，永久伤后下降；不是天才完整人生人口。极重伤引入的额外下降较小，符合该分支本身少见，不能为了让表格“看起来改进很大”改骰子。\n\n标准富裕者高成才率仍然保留，吻合V1A；稀缺需要人口、资格/师承、世界供给和NPC意愿共同验证。掉境分支仍只检查能否完成最初疗伤，未模拟年轻掉境者重修全部流程；掉境无法恢复结果按V3A接受。\n\n## 6. 状态与下一步\n\n已确认：V1A/V2B/V3A/V4AB的取舍；已产出候选2和复验。未自动确认：具体递增函数、原概率指数/上限、失败分支/损失数值、品质/配方、自然供给等可调参常量。没有运行Godot、没有完整人口/经济平衡结论。\n\n下一步可将候选2作为可追溯的验证配置，整理S1任务/验收和配置版本；涉及这些数值的实现仍须标候选或先冻结候选配置，不能将一次评审答复当作所有常量已批准。后续新增问题按关联批次集中，不恢复逐数值提问。\n", "23-突破候选2复验数据.json": "{\n  \"date\": \"2026-10-29\",\n  \"scope\": \"isolated numeric review, not Godot or world simulation\",\n  \"candidate\": \"breakthrough-candidate.2\",\n  \"cost_formula\": \"cost_of_nth_additional_polish_point_in_standard_days = 30*(1+n/2), n>=1\",\n  \"rows\": [\n    {\n      \"stage\": \"foundation\",\n      \"initial_p\": 0.2,\n      \"seed\": 20261028,\n      \"n\": 30000,\n      \"candidate1_success_pct\": 77.96333333333332,\n      \"candidate2_success_pct\": 77.96333333333332,\n      \"outcomes\": {\n        \"寿终\": 6611,\n        \"晋阶成功\": 23389\n      },\n      \"permanent_wound_events\": 0\n    },\n    {\n      \"stage\": \"foundation\",\n      \"initial_p\": 0.7,\n      \"seed\": 20261029,\n      \"n\": 30000,\n      \"candidate1_success_pct\": 99.94333333333333,\n      \"candidate2_success_pct\": 99.94333333333333,\n      \"outcomes\": {\n        \"晋阶成功\": 29983,\n        \"寿终\": 17\n      },\n      \"permanent_wound_events\": 0\n    },\n    {\n      \"stage\": \"foundation\",\n      \"initial_p\": 0.95,\n      \"seed\": 20261030,\n      \"n\": 30000,\n      \"candidate1_success_pct\": 100.0,\n      \"candidate2_success_pct\": 100.0,\n      \"outcomes\": {\n        \"晋阶成功\": 30