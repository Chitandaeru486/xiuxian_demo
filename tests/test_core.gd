extends SceneTree
const World = preload("res://core/world.gd")
const Rules = preload("res://core/rules.gd")
var failures=0
var checks=0

func check(condition: bool, label: String) -> void:
	checks+=1
	if not condition:
		failures+=1
		push_error("FAIL " + label)

func fresh(count: int=3):
	var w=World.new()
	w.initialize(20261029,count)
	w.fixture_enabled=true
	return w

func command(id: String, kind: String, payload: Dictionary, issuer: String="NPC", at: int=0) -> Dictionary:
	return {"command_id":id,"issuer":issuer,"issued_at":at,"execute_at":at,"type":kind,"payload":payload}

func _init() -> void:
	call_deferred("run")

func run() -> void:
	var a=fresh()
	var b=fresh()
	check(World.canonical(a.snapshot())==World.canonical(b.snapshot()),"deterministic creation")
	check(World.validate_snapshot(a.snapshot()).ok,"initial state valid")
	check(not World.new().fixture_enabled,"fixtures default disabled")
	a.advance_minutes(43200-1)
	check(a.date_parts()=={"year":1,"month":1,"day":30,"hour":23,"minute":59},"AC01 month end")
	a.advance_minutes(1)
	check(a.date_parts().month==2 and a.date_parts().day==1,"AC01 month rollover")
	a.advance_minutes(518400-43200)
	check(a.date_parts().year==2 and a.date_parts().month==1,"AC01 year rollover")
	check(a.autosave_snapshots.size()==12,"automatic exact boundaries")
	for i in a.autosave_snapshots.size():
		check(a.autosave_snapshots[i].world_minute==(i+1)*43200,"autosave boundary %d"%i)
		check(World.validate_snapshot(a.autosave_snapshots[i]).ok,"autosave snapshot valid %d"%i)
	a=fresh()
	a.advance_real_us(24000000)
	check(a.state.world_minute==1440,"AC02 daily speed")
	b=fresh()
	b.set_multiplier(360)
	b.advance_real_us(24000000)
	check(b.state.world_minute==518400,"AC02 annual speed")
	a=fresh()
	a.advance_real_us(1000000)
	a.set_multiplier(360)
	a.advance_real_us(1000000)
	check(a.state.world_minute==21660,"AC03 mixed speeds")
	a=fresh()
	b=fresh()
	for i in 100: a.advance_real_us(12345)
	b.advance_real_us(1234500)
	check(World.canonical(a.snapshot())==World.canonical(b.snapshot()),"AC03 fragmented real delta")
	a.set_paused(true)
	var before=a.snapshot()
	a.advance_real_us(1000000)
	check(a.snapshot()==before,"AC04 paused world unchanged")
	a.set_multiplier(360)
	check(a.state.paused,"AC04 speed switch preserves pause")
	a=fresh()
	a.advance_minutes(10000,1)
	check(a.state.world_minute==60 and a.state.pending_minutes==9940,"performance backlog retained")
	a.advance_minutes(0)
	check(a.state.world_minute==10000,"backlog consumed")
	a=fresh()
	var p:Dictionary=a.state.persons.P1
	p.lifespan_quantile=5000
	p.birth_minute=-70*Rules.YEAR+100
	check(a.fixture_schedule("breakthrough_complete","P1",100,{"realm":"炼气"}).ok,"AC05 prior legal action")
	a.advance_minutes(101)
	check(a.state.persons.P1.alive and a.state.persons.P1.realm=="炼气","AC05 breakthrough precedes death")
	check(a.person_summary("P1").age_minutes==70*Rules.YEAR+1,"AC06 age not reset")
	check(not a.fixture_schedule("breakthrough_complete","P2",a.state.world_minute,{"realm":"炼气"}).ok,"reject same-time synthetic breakthrough")
	check(a.fixture_change_person("P1",{"burn_days":3600,"root_scar":5,"g_trained":50}).ok,"AC06 burn and scar fixture")
	check(a.person_summary("P1").root_effective==45 and a.person_summary("P1").root_cap==95,"scar once root50")
	a.fixture_change_person("P1",{"g_trained":100})
	check(a.person_summary("P1").root_effective==95,"scar once root100")
	a.fixture_change_person("P1",{"realm":"凡人"})
	check(not a.state.persons.P1.alive and a.state.persons.P1.burn_days==3600,"downgrade immediate death burn permanent")
	check(not a.fixture_schedule("move_complete","P1",200,{"position":[1,2]}).ok,"dead person cannot act")
	a=fresh()
	var c=command("M1","set_target",{"person_id":"P1","target":"observe"})
	var result=a.submit(c)
	before=a.snapshot()
	check(a.submit(c)==result and a.snapshot()==before,"AC08 exact resend no effect")
	c.payload.target="changed"
	check(a.submit(c).error_code=="command_id_conflict" and a.snapshot()==before,"AC08 conflict retains original")
	var business=a.state.persons.duplicate(true)
	var rng=a.state.rng_state
	check(a.submit(command("M2","set_target",{"person_id":"P1","target":"god"},"天道")).error_code=="permission_denied","AC09 permissions")
	check(a.state.persons==business and a.state.rng_state==rng,"AC09 rejected no business/RNG mutation")
	before=a.snapshot()
	check(not a.fixture_transfer("P1","P2",20,true).ok and a.snapshot()==before,"AC10 fault rolls back debit and counters")
	check(a.fixture_transfer("P1","P2",20).ok and a.state.persons.P1.wallet.balance==80 and a.state.persons.P2.wallet.balance==120,"AC10 atomic transfer")
	a=fresh()
	a.follow_person("P1")
	a.follow_person("P2")
	a.fixture_schedule("reminder","P1",100,{"notification_id":"Nfixed1"})
	a.fixture_schedule("reminder","P2",100,{"notification_id":"Nfixed2"})
	a.fixture_schedule("plan","P3",100)
	a.fixture_schedule("move_complete","P1",120,{"position":[11,12]})
	a.advance_minutes(10000)
	check(a.state.paused and a.state.world_minute==100 and a.state.pending_minutes==0 and a.state.discarded_minutes==9900,"AC12 exact event pause discard")
	check(a.state.notifications.size()==2,"AC13 same-time batch")
	check(a.state.queue[0].kind=="plan","AC14 retains later phase")
	b=fresh()
	check(b.restore(a.snapshot()).ok,"AC14 paused restore")
	a.resume()
	b.resume()
	a.advance_minutes(0)
	b.advance_minutes(0)
	check(a.state.queue[0].due_minute==120 and not a.state.paused,"resume same-minute later phase")
	a.fixture_schedule("reminder","P1",110,{"notification_id":"Nfixed1"})
	b.fixture_schedule("reminder","P1",110,{"notification_id":"Nfixed1"})
	a.advance_minutes(30)
	b.advance_minutes(30)
	check(not a.state.paused and a.state.notifications.size()==2,"AC13 redelivery no pause")
	check(a.state.persons.P1.position==[11,12],"action completes exactly once")
	check(World.canonical(a.snapshot())==World.canonical(b.snapshot()),"AC14 continuation equivalence")
	check(World.validate_snapshot(a.snapshot()).ok,"result world valid")
	a=fresh()
	a.fixture_schedule("random_complete","P1",100)
	a.advance_minutes(50)
	b=fresh()
	b.restore(a.snapshot())
	a.advance_minutes(100)
	b.advance_minutes(100)
	check(World.canonical(a.snapshot())==World.canonical(b.snapshot()),"AC21 future random sequence restore")
	a=fresh()
	before=a.snapshot()
	var bad=before.duplicate(true)
	bad.persons.P1.realm="元婴"
	check(not a.restore(bad).ok and a.snapshot()==before,"AC07 illegal realm reject atomic")
	bad=before.duplicate(true)
	bad.persons.P1.position=[192,0]
	check(not a.restore(bad).ok,"AC07 position reject")
	bad=before.duplicate(true)
	bad.persons.P1.id="P2"
	check(not a.restore(bad).ok,"AC07 duplicate identity reject")
	bad=before.duplicate(true)
	bad.persons.P1.wallet.reserved=101
	check(not a.restore(bad).ok,"AC17 excess reservation reject")
	bad=before.duplicate(true)
	bad.persons.P1.wallet.balance=-1
	check(not a.restore(bad).ok,"AC17 negative balance reject")
	bad=before.duplicate(true)
	bad.persons.P1.extensions.unknown_type={}
	check(not a.restore(bad).ok,"AC18 unknown extension reject")
	a.fixture_schedule("action_complete","P1",10)
	bad=a.snapshot()
	bad.actions.A1.kind="unknown"
	check(not a.restore(bad).ok,"AC18 unknown action reject")
	bad=a.snapshot()
	bad.persons.erase("P1")
	check(not a.restore(bad).ok,"AC17 dangling queue/action reject")
	check(not a.advance_real_us(-1).ok,"negative real delta rejected")
	check(not a.advance_real_us(9223372036854775807).ok,"real budget overflow rejected")
	a=fresh()
	a.fixture_schedule("breakthrough_complete","P1",100,{"realm":"炼气"})
	bad=a.snapshot()
	bad.queue[0].payload.realm="元婴"
	check(not World.validate_snapshot(bad).ok,"tampered breakthrough payload rejected")
	bad=a.snapshot()
	bad.actions.A1.payload.realm="筑基"
	check(not World.validate_snapshot(bad).ok,"queue action payload mismatch rejected")
	a=fresh()
	a.fixture_schedule("move_complete","P1",100,{"position":[2,3]})
	bad=a.snapshot()
	bad.queue[0].payload.position=[192,3]
	check(not World.validate_snapshot(bad).ok,"tampered move payload rejected")
	a=fresh()
	a.state.persons.P1.lifespan_quantile=5000
	a.state.persons.P1.birth_minute=-70*Rules.YEAR+100
	a.fixture_schedule("breakthrough_complete","P1",100,{"realm":"凡人"})
	a.advance_minutes(100,2)
	check(a.state.world_minute==100 and a.state.phase_cursor.phase==1,"operation budget retains unfinished phase")
	before=a.snapshot()
	b=fresh()
	check(b.restore(before).ok,"unfinished phase snapshot valid")
	a.advance_minutes(0)
	b.advance_minutes(0)
	check(not a.state.persons.P1.alive and a.state.world_minute==100,"death phase resumes without time advance")
	check(a.snapshot()==b.snapshot(),"unfinished phase restore equivalence")
	a=fresh()
	a.advance_minutes(1)
	a.set_paused(true)
	result=a.submit(command("paused","set_target",{"person_id":"P1","target":"paused target"},"NPC",1))
	check(result.status=="queued" and a.state.persons.P1.target=="","paused command queues")
	a.resume()
	a.advance_minutes(0)
	check(a.state.persons.P1.target=="paused target","same-minute paused command resumes")
	a.set_paused(true)
	a.single_step()
	check(a.state.world_minute==2 and a.state.paused,"single step preserves pause")
	check(a.state.rules.candidate.reference_documents.size()==3,"candidate full reference snapshot")
	a=fresh()
	a.fixture_schedule("random_complete","P1",10)
	a.advance_minutes(10)
	check(World.validate_snapshot(a.snapshot()).ok,"random completion result remains serializable")
	a=fresh()
	bad=a.snapshot()
	bad.phase_cursor.last_sequence="0"
	check(not World.validate_snapshot(bad).ok,"phase sequence must be integer")
	bad=a.snapshot()
	bad.phase_cursor.last_sequence=bad.counters.queue+1
	check(not World.validate_snapshot(bad).ok,"phase sequence cannot exceed queue counter")
	bad=a.snapshot()
	bad.persons.P1.birth_minute=-9007199254740993
	bad.persons.P1.burn_days=int(World.MAX_INT/1440)
	check(not World.validate_snapshot(bad).ok,"derived lifespan underflow rejected")
	a=fresh()
	a.fixture_change_person("P1",{"wallet":{"balance":100,"reserved":50}})
	a.fixture_change_person("P1",{"burn_days":100000})
	check(not a.state.persons.P1.alive and a.state.persons.P1.wallet.reserved==0,"death releases reservation without primary action")
	a=fresh()
	a.fixture_schedule("move_complete","P1",10,{"position":[2,3]})
	bad=a.snapshot()
	bad.world_minute=10
	bad.phase_cursor={"minute":10,"phase":9,"last_sequence":0}
	check(not World.validate_snapshot(bad).ok,"cursor cannot skip same-minute due work")
	a=fresh()
	a.state.persons.P1.birth_minute=-World.MAX_INT
	before=a.snapshot()
	check(not a.advance_minutes(1).ok and a.snapshot()==before,"age overflow rejects input atomically")
	check(not a.advance_real_us(16667).ok and a.snapshot()==before,"real input age overflow preserves numerator")
	a=fresh()
	var invalid_command=command("invalid", "watch", {"person_id":"P1"})
	invalid_command["command_id"]=7
	check(a.submit(invalid_command).status=="rejected","nonstring command identity rejected")
	print("CORE_RESULT checks=%d failures=%d"%[checks,failures])
	quit(0 if failures==0 else 1)
